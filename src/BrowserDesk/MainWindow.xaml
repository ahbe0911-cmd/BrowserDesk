<Window x:Class="BrowserDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrowserDesk.Controls"
        Title="BrowserDesk"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FlowDirection="LeftToRight">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="16"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            FlowDirection="RightToLeft">
                    <TextBlock Text="BrowserDesk"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="CurrentBrowserText"
                               Text="مرورگر انتخاب‌شده: Google Chrome"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AddressBox"
                             Grid.Column="0"
                             Height="40"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             FlowDirection="LeftToRight"
                             Text="https://"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             FontSize="14"
                             KeyDown="AddressBox_KeyDown"/>

                    <Button Grid.Column="1"
                            Content="باز کردن"
                            Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OpenAddress_Click"/>
                </Grid>

                <TextBlock x:Name="CurrentSiteText"
                           Grid.Column="3"
                           Width="220"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           FlowDirection="RightToLeft"
                           Foreground="{StaticResource MutedBrush}"
                           Text="هنوز سایتی باز نشده"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="16"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BookmarksItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BookmarkCardStyle}"
                                        Click="Bookmark_Click"
                                        MouseRightButtonUp="Bookmark_RightClick">
                                    <StackPanel Width="150" FlowDirection="RightToLeft">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FlowDirection="LeftToRight"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1"
                        Content="+ بوک‌مارک"
                        Margin="10,0,0,0"
                        Padding="14,8"
                        Click="ToggleBookmarkEditor_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Margin="0,0,12,0"
                    ClipToBounds="True">
                <Grid>
                    <local:EmbeddedBrowserHost x:Name="BrowserHost"
                                               Visibility="Hidden"/>

                    <StackPanel x:Name="EmptyState"
                                Width="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft">
                        <TextBlock Text="BrowserDesk آماده است"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextAlignment="Center"/>
                        <TextBlock Margin="0,12,0,0"
                                   Text="از سمت راست یک مرورگر انتخاب کن، سپس روی یکی از بوک‌مارک‌های بالا بزن. سایت داخل همین قسمت باز می‌شود."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel FlowDirection="RightToLeft">
                        <TextBlock Text="مرورگر"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="سایت با مرورگر انتخاب‌شده داخل برنامه باز می‌شود."
                                   Margin="0,4,0,14"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>

                        <RadioButton x:Name="ChromeChoice"
                                     Tag="Chrome"
                                     GroupName="Browsers"
                                     IsChecked="True"
                                     Style="{StaticResource BrowserChoiceStyle}"
                                     Checked="BrowserChoice_Checked">
                            <StackPanel>
                                <TextBlock Text="Google Chrome"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <TextBlock x:Name="ChromeVersionText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FlowDirection="LeftToRight"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="FirefoxChoice"
                                     Tag="Firefox"
                                     GroupName="Browsers"
                                     Style="{StaticResource BrowserChoiceStyle}"
                                     Checked="BrowserChoice_Checked">
                            <StackPanel>
                                <TextBlock Text="Mozilla Firefox"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <TextBlock x:Name="FirefoxVersionText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FlowDirection="LeftToRight"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="EdgeChoice"
                                     Tag="Edge"
                                     GroupName="Browsers"
                                     Style="{StaticResource BrowserChoiceStyle}"
                                     Checked="BrowserChoice_Checked">
                            <StackPanel>
                                <TextBlock Text="Microsoft Edge"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <TextBlock x:Name="EdgeVersionText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FlowDirection="LeftToRight"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </RadioButton>

                        <Separator Margin="0,8"/>

                        <Button Content="مدیریت بوک‌مارک‌ها"
                                Padding="12,9"
                                Click="ToggleBookmarkEditor_Click"/>

                        <Border x:Name="BookmarkEditorPanel"
                                Visibility="Collapsed"
                                Margin="0,10,0,0"
                                Padding="12"
                                CornerRadius="12"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="افزودن بوک‌مارک"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBox x:Name="BookmarkNameBox"
                                         Height="36"
                                         Margin="0,0,0,8"
                                         Padding="9,6"
                                         FlowDirection="RightToLeft"
                                         ToolTip="نام بوک‌مارک"/>

                                <TextBox x:Name="BookmarkUrlBox"
                                         Height="36"
                                         Margin="0,0,0,8"
                                         Padding="9,6"
                                         FlowDirection="LeftToRight"
                                         Text="https://"/>

                                <Button Content="ذخیره بوک‌مارک"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddBookmark_Click"/>

                                <TextBlock Margin="0,8,0,0"
                                           Text="برای حذف، روی کارت بوک‌مارک با دکمه راست کلیک کن."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="نکته"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Text="BrowserDesk نسخه نصب‌شده واقعی مرورگرهای ویندوز را استفاده می‌کند؛ بنابراین پس از آپدیت مرورگر، همان نسخه جدید اجرا می‌شود."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
