<Window x:Class="BrowserDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserDesk" Height="720" Width="760"
        MinHeight="600" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F5F7FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BrowserDesk" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="مدیریت بوک‌مارک و مرورگرهای ویندوز"
                               Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock x:Name="BrowserStatusText"
                           Grid.Column="1"
                           FlowDirection="LeftToRight"
                           TextAlignment="Left"
                           FontSize="12"
                           Foreground="#475569"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="باز کردن سریع سایت" FontWeight="Bold" FontSize="16" Margin="4,0,4,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="115"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickUrlBox" Grid.Column="0" FlowDirection="LeftToRight" Text="https://"/>
                    <ComboBox x:Name="QuickBrowserCombo" Grid.Column="1">
                        <ComboBoxItem Content="Google Chrome" Tag="Chrome"/>
                        <ComboBoxItem Content="Mozilla Firefox" Tag="Firefox"/>
                        <ComboBoxItem Content="Microsoft Edge" Tag="Edge"/>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Content="باز کردن"
                            Click="OpenQuick_Click"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="4,8,4,0">
                    <CheckBox x:Name="TileLeftCheckBox"
                              Content="مرورگر در ۵۰٪ سمت چپ"
                              IsChecked="True"
                              Margin="0,0,18,0"/>
                    <CheckBox x:Name="DockManagerRightCheckBox"
                              Content="BrowserDesk در ۵۰٪ سمت راست"
                              IsChecked="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="بوک‌مارک‌ها"
                           FontWeight="Bold"
                           FontSize="17"
                           Margin="4,0,4,8"/>

                <DataGrid x:Name="BookmarksGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          MouseDoubleClick="BookmarksGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="آدرس" Binding="{Binding Url}" Width="*"/>
                        <DataGridTextColumn Header="مرورگر" Binding="{Binding Browser}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BookmarkNameBox" Grid.Column="0" ToolTip="نام بوک‌مارک"/>
                    <TextBox x:Name="BookmarkUrlBox" Grid.Column="1" FlowDirection="LeftToRight" Text="https://"/>
                    <ComboBox x:Name="BookmarkBrowserCombo" Grid.Column="2">
                        <ComboBoxItem Content="Chrome" Tag="Chrome"/>
                        <ComboBoxItem Content="Firefox" Tag="Firefox"/>
                        <ComboBoxItem Content="Edge" Tag="Edge"/>
                    </ComboBox>
                    <Button Grid.Column="3" Content="افزودن" Click="AddBookmark_Click"/>
                    <Button Grid.Column="4" Content="حذف" Click="DeleteBookmark_Click"/>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="5,10,5,0"
                   Foreground="#64748B"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="BrowserDesk همان Chrome، Firefox و Edge نصب‌شده روی ویندوز را اجرا می‌کند؛ بنابراین با به‌روزرسانی مرورگر اصلی، نسخه جدید به‌طور خودکار استفاده می‌شود."/>
    </Grid>
</Window>
