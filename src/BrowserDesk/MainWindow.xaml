<Window x:Class="BrowserDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserDesk"
        Width="1440"
        Height="880"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FlowDirection="LeftToRight">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="248"/>
        </Grid.ColumnDefinitions>

        <!-- MAIN -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Browsers + address -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="18"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="مرورگر"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   FlowDirection="RightToLeft"
                                   Margin="8,0,18,0"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <RadioButton x:Name="ChromeChoice"
                                         Tag="Chrome"
                                         GroupName="Browsers"
                                         IsChecked="True"
                                         Style="{StaticResource BrowserChoiceStyle}"
                                         Checked="BrowserChoice_Checked">
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#E8F0FE" Margin="0,0,9,0">
                                        <TextBlock Text="C" Foreground="#2563EB" FontWeight="Bold"
                                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Google Chrome" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="ChromeVersionText"
                                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                   FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="FirefoxChoice"
                                         Tag="Firefox"
                                         GroupName="Browsers"
                                         Style="{StaticResource BrowserChoiceStyle}"
                                         Checked="BrowserChoice_Checked">
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#FFF1E8" Margin="0,0,9,0">
                                        <TextBlock Text="F" Foreground="#EA580C" FontWeight="Bold"
                                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Mozilla Firefox" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="FirefoxVersionText"
                                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                   FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="EdgeChoice"
                                         Tag="Edge"
                                         GroupName="Browsers"
                                         Style="{StaticResource BrowserChoiceStyle}"
                                         Checked="BrowserChoice_Checked">
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#E7F8F6" Margin="0,0,9,0">
                                        <TextBlock Text="E" Foreground="#0F766E" FontWeight="Bold"
                                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Microsoft Edge" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="EdgeVersionText"
                                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                   FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="108"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="#FBFDFF">
                            <TextBox x:Name="AddressBox"
                                     Height="42"
                                     Padding="12,8"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"
                                     Text="https://"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     KeyDown="AddressBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="تب جدید"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenAddress_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Horizontal bookmark cards -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="18"
                    Padding="12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Width="112"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft"
                                Margin="4,0,10,0">
                        <TextBlock Text="سایت‌ها"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="بوک‌مارک‌ها"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="BookmarksItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BookmarkCardStyle}"
                                            Click="Bookmark_Click"
                                            MouseRightButtonUp="Bookmark_RightClick">
                                        <Grid Width="158">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="28" Height="28"
                                                        CornerRadius="8"
                                                        Background="#EEF2FF">
                                                    <TextBlock Text="↗"
                                                               FontSize="13"
                                                               Foreground="#4F46E5"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           FlowDirection="RightToLeft"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,7,0,0"
                                                       Text="{Binding Url}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FlowDirection="LeftToRight"
                                                       TextAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status line -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,7"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentSiteText"
                               Grid.Column="0"
                               Text="آماده"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FlowDirection="RightToLeft"/>
                    <TextBlock x:Name="TabCountText"
                               Grid.Column="1"
                               Text="۰ تب باز"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FlowDirection="RightToLeft"/>
                </Grid>
            </Border>

            <!-- Tabs + embedded real browsers -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="18"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <TabControl x:Name="BrowserTabs"
                                Background="White"
                                BorderThickness="0"
                                SelectionChanged="BrowserTabs_SelectionChanged"/>

                    <StackPanel x:Name="EmptyState"
                                Width="470"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft">
                        <Border Width="62" Height="62" CornerRadius="20"
                                Background="{StaticResource AccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="↗"
                                       FontSize="28"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="یک سایت را باز کن"
                                   Margin="0,18,0,0"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextAlignment="Center"/>
                        <TextBlock Margin="0,8,0,0"
                                   Text="مرورگر را از بالای صفحه انتخاب کن و سپس روی یکی از کارت‌های سایت بزن. هر سایت در یک تب جدا داخل BrowserDesk باز می‌شود."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT VERTICAL SIDEBAR -->
        <Border Grid.Column="1"
                Background="#0F172A"
                CornerRadius="20"
                Padding="16">
            <Grid FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="46" Height="46" CornerRadius="14"
                            Background="#2563EB"
                            HorizontalAlignment="Right">
                        <TextBlock Text="B"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BrowserDesk"
                               Margin="0,12,0,0"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="مدیریت سایت‌ها و مرورگرها"
                               Margin="0,3,0,0"
                               Foreground="#94A3B8"
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock Text="بوک‌مارک"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"/>
                    <TextBlock Text="سایت جدید را از اینجا اضافه کن"
                               Margin="0,3,0,10"
                               Foreground="#94A3B8"
                               FontSize="10"/>

                    <TextBlock Text="نام سایت"
                               Foreground="#CBD5E1"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <Border Background="#172033" CornerRadius="10" Margin="0,0,0,9">
                        <TextBox x:Name="BookmarkNameBox"
                                 Height="38"
                                 Padding="10,7"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FlowDirection="RightToLeft"/>
                    </Border>

                    <TextBlock Text="آدرس سایت"
                               Foreground="#CBD5E1"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <Border Background="#172033" CornerRadius="10" Margin="0,0,0,10">
                        <TextBox x:Name="BookmarkUrlBox"
                                 Height="38"
                                 Padding="10,7"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FlowDirection="LeftToRight"
                                 Text="https://"/>
                    </Border>

                    <Button Content="+ افزودن سایت"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddBookmark_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <TextBlock Text="راهنما"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,7,0,0"
                               Text="• مرورگر را از بالای صفحه انتخاب کن&#x0a;• روی کارت سایت بزن&#x0a;• هر سایت در تب جدا باز می‌شود&#x0a;• راست‌کلیک روی کارت = حذف بوک‌مارک"
                               Foreground="#94A3B8"
                               FontSize="11"
                               LineHeight="22"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="#172033"
                        CornerRadius="12"
                        Padding="11">
                    <StackPanel>
                        <TextBlock Text="فونت فارسی"
                                   Foreground="#CBD5E1"
                                   FontSize="10"/>
                        <TextBlock Text="Vazirmatn"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
